      "id": "softmax-normalizes",
      "chapter": "softmax",
      "heading": "为什么每个输出介于零和一之间，且总和为一",
      "anchor_text": "为什么所有概率之和为一",
      "formula_anchor": "\\sum_{i=1}^K p_i = \\sum_i \\frac{e^{z_i}}{\\sum_j e^{z_j}} = \\frac{\\sum_i e^{z_i}}{\\sum_j e^{z_j}} = 1",
      "formula_fingerprint": "60c97b7ff9d6fdf0b469a263101217dd2c25c7a12d3997c3ddf79d4eea709a30",
      "evaluator": "softmax",
      "inputs": {
        "logits": [
          0,
          0
        ]
      },
      "expected": [
        0.5,
        0.5
      ],
      "tolerance": 1E-12,
      "domain": "finite logits",
      "review": {
